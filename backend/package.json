{
  "name": "vitalia-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "npm run build && jest --runInBand",
    "worker": "node --env-file-if-exists=.env dist/database/run-processing.js",
    "migrate": "node --env-file-if-exists=.env dist/database/migrate-all.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@tesseract.js-data/spa": "1.0.0",
    "express": "5.1.0",
    "multer": "2.4.0",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "tesseract.js": "7.0.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/multer": "2.3.0",
    "@types/node": "22.18.6",
    "@types/pg": "8.23.1",
    "jest": "30.2.0",
    "supertest": "7.1.4",
    "typescript": "5.9.3"
  }
}
