# Configuración de desarrollo. No contiene credenciales.
PORT=3000
HOST=127.0.0.1

# PostgreSQL local: completar la contraseña únicamente en .env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=vitalia_dev
PGUSER=vitalia_app
PGPASSWORD=

# S3 privado: completar únicamente cuando exista el bucket.
AWS_REGION=
S3_BUCKET=
# Perfil local de AWS CLI; las credenciales no se escriben en este archivo.
# AWS_PROFILE=vitalia-dev
